digraph wolfdb_schema {
    graph [
        label="WolfDB — application database schema",
        labelloc="t",
        fontsize=22,
        fontname="Helvetica",
        rankdir=LR,
        nodesep=0.45,
        ranksep=1.4,
        splines=spline,
        bgcolor="white",
        pad=0.3
    ];

    node [shape=plain, fontname="Helvetica", fontsize=9];
    edge [fontname="Helvetica", fontsize=8, color="#78909c", arrowsize=0.7];

    // PostgreSQL currently declares no FOREIGN KEY constraints. Dashed edges
    // below document the logical relationships used by the application.

    subgraph cluster_sampling {
        label="Sampling and field data";
        color="#90caf9";
        style="rounded,dashed";

        scats [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="5" BGCOLOR="#1976d2"><FONT COLOR="white"><B>scats</B></FONT></TD></TR>
            <TR><TD PORT="scat_id_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>scat_id</B></TD><TD ALIGN="LEFT">varchar</TD><TD PORT="scat_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">date</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="wa_code_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">wa_code</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="wa_code_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sampling_season</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sampling_type</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="path_id_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">path_id</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="path_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="snowtrack_id_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">snowtrack_id</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="snowtrack_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">municipality</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">province</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">deposition</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">matrix</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">collected_scat</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">scalp_category</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">genetic_sample</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">coord_east</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">coord_north</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">coord_zone</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">observer</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">institution</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">geometry_utm</TD><TD ALIGN="LEFT">geometry</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">region_auto</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">province_auto</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">municipality_auto</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">location_auto</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sample_type</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">box_number</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">ispra_id</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
        </TABLE>>];

        dead_wolves [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="5" BGCOLOR="#1976d2"><FONT COLOR="white"><B>dead_wolves</B></FONT></TD></TR>
            <TR><TD PORT="id_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>UQ</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">integer</TD><TD PORT="id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="genotype_id_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">genotype_id</TD><TD ALIGN="LEFT">text</TD><TD PORT="genotype_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD><B>UQ</B></TD><TD ALIGN="LEFT">tissue_id</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">discovery_date</TD><TD ALIGN="LEFT">date</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">municipality</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">province</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="wa_code_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">wa_code</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="wa_code_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">deleted</TD><TD ALIGN="LEFT">timestamp</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">utm_east</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">utm_north</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">geometry_utm</TD><TD ALIGN="LEFT">geometry</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">utm_zone</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">box_number</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">scalp_category</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sampling_season</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">operator</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">institution</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
        </TABLE>>];

        paths [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="5" BGCOLOR="#1976d2"><FONT COLOR="white"><B>paths</B></FONT></TD></TR>
            <TR><TD PORT="path_id_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>path_id</B></TD><TD ALIGN="LEFT">varchar</TD><TD PORT="path_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="transect_id_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">transect_id</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="transect_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">date</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sampling_season</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">completeness</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">observer</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">institution</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">created</TD><TD ALIGN="LEFT">timestamp</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">experience_index</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
        </TABLE>>];

        snow_tracks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="5" BGCOLOR="#1976d2"><FONT COLOR="white"><B>snow_tracks</B></FONT></TD></TR>
            <TR><TD PORT="snowtrack_id_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>snowtrack_id</B></TD><TD ALIGN="LEFT">varchar</TD><TD PORT="snowtrack_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="transect_id_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">transect_id</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="transect_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">date</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sampling_season</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">track_type</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">municipality</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">province</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">observer</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">institution</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">scalp_category</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sampling_type</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">days_after_snowfall</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">minimum_number_of_wolves</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">track_format</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">text</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">multilines</TD><TD ALIGN="LEFT">geometry</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">coord_east</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">coord_north</TD><TD ALIGN="LEFT">integer</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">coord_zone</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
        </TABLE>>];

        transects [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="5" BGCOLOR="#1976d2"><FONT COLOR="white"><B>transects</B></FONT></TD></TR>
            <TR><TD PORT="transect_id_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>transect_id</B></TD><TD ALIGN="LEFT">varchar</TD><TD PORT="transect_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sector</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">location</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">municipality</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">province</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
