    // Logical relations used by WolfDB (not enforced as PostgreSQL FKs).
    // Edge ports sit at the table boundary, outside the field/type text.
    edge [style=dashed, penwidth=1.1];

    scats:path_id_out:e -> paths:path_id_in:w;
    scats:snowtrack_id_out:e -> snow_tracks:snowtrack_id_in:w;
    scats:wa_code_out:e -> wa_results:wa_code_in:w;
    dead_wolves:wa_code_out:e -> wa_results:wa_code_in:w;
    dead_wolves:genotype_id_out:e -> genotypes:genotype_id_in:w;

    paths:transect_id_out:e -> transects:transect_id_in:w;
    snow_tracks:transect_id_out:e -> transects:transect_id_in:w;
    transects:province_code_out:e -> geo_info:province_code_in:w;

    wa_results:genotype_id_out:e -> genotypes:genotype_id_in:w;
    wa_results:laboratory_acronym_out:e -> laboratories:acronym_in:w;
    wa_locus:wa_code_out:e -> wa_results:wa_code_in:w;
    wa_locus:laboratory_acronym_out:e -> wa_results:laboratory_acronym_in:w;
    wa_locus:locus_out:e -> loci:name_in:w;
    wa_locus:user_id_out:e -> users:email_in:w;
    wa_loci_values:wa_code_out:e -> wa_results:wa_code_in:w;
    wa_loci_values:laboratory_acronym_out:e -> wa_results:laboratory_acronym_in:w;

    genotype_locus:genotype_id_out:e -> genotypes:genotype_id_in:w;
    genotype_locus:locus_out:e -> loci:name_in:w;
    genotype_locus:user_id_out:e -> users:email_in:w;
    // Separate routing labels keep the two parent references distinguishable.
    {
        rank=same;
        mother_reference [shape=plaintext, label="mother", fontcolor="#00897b", fontsize=10];
        father_reference [shape=plaintext, label="father", fontcolor="#e65100", fontsize=10];
    }
    genotypes:mother_out:e -> mother_reference:w [color="#00897b", penwidth=1.6, arrowhead=none];
    mother_reference:w -> genotypes:genotype_id_out:e [color="#00897b", penwidth=1.6, constraint=false];
    genotypes:father_out:e -> father_reference:w [color="#e65100", penwidth=1.6, arrowhead=none];
    father_reference:w -> genotypes:genotype_id_out:e [color="#e65100", penwidth=1.6, constraint=false];

    dead_wolves_values:id_out:e -> dead_wolves:id_in:w;
    dead_wolves_values:field_id_out:e -> dead_wolves_fields_definition:field_id_in:w;

    istat_province:cod_reg_out:e -> istat_regioni:cod_reg_in:w;
    comuni:cod_prov_out:e -> istat_province:cod_prov_in:w;
    comuni:cod_reg_out:e -> istat_regioni:cod_reg_in:w;

    subgraph cluster_legend {
        label="Legend";
        color="#cfd8dc";
        style="rounded";

        legend_keys [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#eceff1"><B>Markers</B></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B> = primary key</TD></TR>
            <TR><TD ALIGN="LEFT"><B>UQ</B> = unique constraint</TD></TR>
            <TR><TD ALIGN="LEFT">Dashed edge = logical relation</TD></TR>
            <TR><TD ALIGN="LEFT">Arrow: referencing field to referenced field</TD></TR>
            <TR><TD ALIGN="LEFT"><FONT COLOR="#00897b">mother</FONT> / <FONT COLOR="#e65100">father</FONT> = parent genotype</TD></TR>
            <TR><TD ALIGN="LEFT">Views: see database_views.dot</TD></TR>
        </TABLE>>];
    }
}
