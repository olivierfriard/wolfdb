            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">extraction_lab_apam_id</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="genotype_id_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">genotype_id</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="genotype_id_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">mtdna</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">sex_id</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">recapture_old_individual</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">individual_id</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">matching</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">quality_genotype</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">box_number</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="laboratory_acronym_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>laboratory_acronym</B></TD><TD ALIGN="LEFT">text</TD><TD PORT="laboratory_acronym_out" WIDTH="8" CELLPADDING="0"></TD></TR>
