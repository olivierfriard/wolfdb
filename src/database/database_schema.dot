            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">multilines</TD><TD ALIGN="LEFT">geometry</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD PORT="province_code_in" WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">province_code</TD><TD ALIGN="LEFT">varchar</TD><TD PORT="province_code_out" WIDTH="8" CELLPADDING="0"></TD></TR>
        </TABLE>>];
    }

    subgraph cluster_genetics {
        label="Genetics";
        color="#ce93d8";
        style="rounded,dashed";

        wa_results [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="5" BGCOLOR="#7b1fa2"><FONT COLOR="white"><B>wa_results</B></FONT></TD></TR>
            <TR><TD PORT="wa_code_in" WIDTH="8" CELLPADDING="0"></TD><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>wa_code</B></TD><TD ALIGN="LEFT">varchar</TD><TD PORT="wa_code_out" WIDTH="8" CELLPADDING="0"></TD></TR>
            <TR><TD WIDTH="8" CELLPADDING="0"></TD><TD></TD><TD ALIGN="LEFT">package_sent</TD><TD ALIGN="LEFT">varchar</TD><TD WIDTH="8" CELLPADDING="0"></TD></TR>
